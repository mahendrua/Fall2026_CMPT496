# Cloud Functions params for Checkpoint (committed; contains no secrets).
#
# Test-only Checkpoint Pro checkout. Keep this false: it is the value used by
# deploys. Without a value here, the Firebase CLI stops and prompts for it,
# which leaves the Functions emulator unloaded.
#
# To turn test checkout on for the local emulators only, create
# functions/.env.local (git-ignored, never deployed) containing:
#   CHECKPOINT_TEST_PAYMENTS=true
CHECKPOINT_TEST_PAYMENTS=false
