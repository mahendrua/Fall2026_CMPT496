{
  "name": "checkpoint",
  "version": "1.0.0",
  "description": "Codebase Analysis System",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "test": "node --test \"test/**/*.test.js\" \"test/*_test.js\"",
    "build:auth": "esbuild auth.js --bundle --format=iife --platform=browser --target=chrome120 --outfile=auth.bundle.js",
    "prestart": "npm run build:auth",
    "start": "electron .",
    "predist": "npm run build:auth",
    "dist": "electron-builder build --win"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/WyattHapper/CMPT-496-Capstone.git"
  },
  "license": "ISC",
  "devDependencies": {
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "electron-reloader": "^1.2.3",
    "esbuild": "^0.28.2",
    "yazl": "^3.3.1"
  },
  "dependencies": {
    "@firebase/app": "^0.16.4",
    "@firebase/auth": "^1.13.8",
    "dotenv": "^17.4.2",
    "yauzl": "^3.4.0"
  },
  "build": {
    "appId": "com.cmpt496.checkpoint",
    "productName": "Checkpoint",
    "win": {
      "target": "nsis",
      "icon": "assets/checkpoint.ico"
    },
    "extraResources": [
      {
        "from": "releases/main",
        "to": "backend"
      },
      {
        "from": "gui-runner",
        "to": "gui-runner"
      },
      {
        "from": "gui-proxy",
        "to": "gui-proxy"
      }
    ]
  }
}
